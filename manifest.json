{
  "manifest_version": 3,
  "name": "Illustration Archive",
  "version": "0.5.0",
  "description": "いいね（ブックマーク）した作品を、選択したローカルフォルダーへ保存します。",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["https://www.pixiv.net/*", "https://i.pximg.net/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pixiv_image_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/artworks/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Illustration Archive",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "src/archive.html"
}
